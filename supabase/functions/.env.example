# Copia este archivo a functions/.env (ignorado por git, ver supabase/.gitignore)
# y completa los valores reales. supabase start lo carga automaticamente en el
# edge runtime local. Para un proyecto Supabase alojado, usa en su lugar:
#   supabase secrets set --env-file supabase/functions/.env
#
# Usados por supabase/functions/portal-acceso/smtp.ts (envio de credenciales
# del portal del propietario, ver CLAUDE.md seccion 14).

VETCARE_SMTP_HOST=smtp.gmail.com
VETCARE_SMTP_PORT=587
VETCARE_SMTP_USUARIO=
VETCARE_SMTP_PASSWORD=
VETCARE_SMTP_TLS=true
VETCARE_SMTP_REMITENTE=
